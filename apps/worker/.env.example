# Copy to apps/worker/.env on your Mac. Never commit .env.
# In GitHub Actions these come from repository secrets, not from this file.

# Garmin Connect → Settings → Personal API token. Choose the 1-year expiry. See docs/SETUP.md §3.
GARMIN_PERSONAL_API_KEY=

# Supabase project (Phase 1). Service role key is for the worker only: never put it in Vercel or the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npx supabase db push` on your Mac; the worker never reads it.
SUPABASE_DB_PASSWORD=

# Calendar day for all rollups.
TZ=Asia/Manila
