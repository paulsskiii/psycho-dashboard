# Copy to apps/web/.env.local for local dev. Set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local.

# Public (shipped to the browser). RLS protects the data, not these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The only email allowed to sign in.
OWNER_EMAIL=

# Server-only. GitHub fine-grained token with Actions: read and write on paulsskiii/psycho only.
# Used by the "Sync now" server action to dispatch the sync workflow. See docs/SETUP.md §3.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=your-github-user/your-repo

# Public. MapTiler key restricted to your Vercel domain + localhost (docs/SETUP.md §6).
NEXT_PUBLIC_MAPTILER_KEY=
